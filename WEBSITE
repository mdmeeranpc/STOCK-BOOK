<!DOCTYPE html>
<html>
<head>
  <title>GLOBAL INDIA CERAMICS</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

<style>
body {
  font-family: 'Segoe UI', sans-serif;
  margin: 0;
  background: linear-gradient(135deg, #667eea, #764ba2);
}

header {
  background: linear-gradient(135deg, #ff7e5f, #feb47b);
  color: white;
  padding: 18px;
  text-align: center;
  font-size: 20px;
  font-weight: bold;
}

.container { padding: 12px; }

input {
  width: 100%;
  padding: 12px;
  border-radius: 25px;
  border: none;
  margin-bottom: 10px;
}

.top-bar { display: flex; gap: 10px; }

button {
  flex: 1;
  padding: 12px;
  border-radius: 25px;
  border: none;
  color: white;
  font-weight: bold;
}

.refresh { background: linear-gradient(135deg,#f7971e,#ffd200); }
.cartBtn { background: linear-gradient(135deg,#00c9ff,#92fe9d); color:#111; }

.card {
  background: white;
  border-radius: 18px;
  padding: 12px;
  margin-top: 12px;
  box-shadow: 0 6px 18px rgba(0,0,0,0.2);
  display: flex;
  justify-content: space-between;
}

.name { font-weight: bold; }
.low { color: orange; }
.out { color: red; }

.qty {
  width: 60px;
  padding: 6px;
  border-radius: 10px;
  text-align: center;
}

.add {
  margin-top: 5px;
  padding: 6px 12px;
  border-radius: 10px;
  background: linear-gradient(135deg,#36d1dc,#5b86e5);
  color: white;
}

#cartBox {
  position: fixed;
  bottom: 0;
  width: 100%;
  height: 75%;
  background: white;
  border-radius: 25px 25px 0 0;
  display: none;
  padding: 15px;
  overflow-y: auto;
}

.cart-item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 10px;
  padding: 10px;
  border-radius: 12px;
  background: #f1f5f9;
}

.remove {
  background: red;
  color: white;
  border-radius: 6px;
  padding: 4px 8px;
}

.badge {
  position: absolute;
  top: -5px;
  right: -5px;
  background: red;
  color: white;
  font-size: 12px;
  padding: 2px 6px;
  border-radius: 50%;
}
</style>
</head>

<body>

<header>🛠️ GLOBAL INDIA CERAMICS</header>

<div class="container">

  <input type="text" id="search" placeholder="🔍 Search..." onkeyup="searchProduct()">

  <div class="top-bar">
    <button class="refresh" onclick="refreshData()">🔄</button>

    <div style="position:relative;flex:1;">
      <button class="cartBtn" onclick="openCart()">🛒 Cart</button>
      <div class="badge" id="cartCount">0</div>
    </div>
  </div>

  <div id="lastUpdated"></div>
  <div id="stockList">Loading...</div>

</div>

<div id="cartBox">
  <h3>🛒 Your Cart</h3>
  <div id="cartItems"></div>
  <br>
  <button onclick="sendCart()" class="cartBtn">Send Order</button>
  <button onclick="clearCart()" style="background:red;">Clear</button>
  <button onclick="closeCart()" style="background:gray;">Close</button>
</div>

<script>
const API_URL = "https://script.google.com/macros/s/AKfycbyymzyoUrYUZgounhIxCXdlYrIBYMoMTIFcHdTTOgH773Oxekb0P4TSODWUhpnvewx-nA/exec";

let cart = [];
let allProducts = [];

/* LOAD PRODUCTS */
function loadData(){
  fetch(API_URL)
    .then(res => res.json())
    .then(data => {
      allProducts = data;
      renderProducts(allProducts);
      document.getElementById("lastUpdated").innerText =
        "Updated: " + new Date().toLocaleTimeString();
    })
    .catch(()=> toast("API error"));
}

/* SHOW PRODUCTS */
function renderProducts(products){
  let container = document.getElementById("stockList");
  container.innerHTML = "";

  products.forEach(item=>{
    let cls="", text=item.qty;
    if(item.qty===0){ text="Out"; cls="out"; }
    else if(item.qty<5){ cls="low"; }

    let id=btoa(item.product);

    let div=document.createElement("div");
    div.className="card";

    div.innerHTML=`
      <div>
        <div class="name">${item.product}</div>
        <div class="${cls}">Stock: ${text}</div>
      </div>

      <div>
        <input type="number" min="1" max="${item.qty}" value="1" id="qty-${id}" class="qty">
        ${item.qty===0 ? "Out" :
        `<button class="add" onclick="addToCart('${item.product}',${item.qty})">Add</button>`}
      </div>
    `;

    container.appendChild(div);
  });
}

/* ADD CART */
function addToCart(product, stockQty){
  let qty=parseInt(document.getElementById("qty-"+btoa(product)).value);
  if(!qty||qty<=0) return toast("Invalid qty");
  if(qty>stockQty) return toast("Not enough stock");

  let exist=cart.find(i=>i.product===product);
  if(exist){exist.qty+=qty;}
  else{cart.push({product,qty});}

  updateCart();
  toast("Added");
}

function updateCart(){
  document.getElementById("cartCount").innerText=cart.length;
}

function openCart(){
  let div=document.getElementById("cartItems");

  let form = `
    <input id="custName" placeholder="👤 Name">
    <input id="custPhone" placeholder="📞 Phone">
  `;

  if(cart.length===0){
    div.innerHTML = form + "<br>Cart empty";
  } else {
    div.innerHTML = form + cart.map((i,idx)=>`
      <div class="cart-item">
        ${i.product} (x${i.qty})
        <button class="remove" onclick="removeItem(${idx})">X</button>
      </div>
    `).join("");
  }

  document.getElementById("cartBox").style.display="block";
}

function closeCart(){
  document.getElementById("cartBox").style.display="none";
}

function removeItem(i){
  cart.splice(i,1);
  openCart();
  updateCart();
}

function clearCart(){
  cart=[];
  openCart();
  updateCart();
}

/* SEND ORDER (FIXED) */
function sendCart(){
  if(!cart.length) return toast("Cart empty");

  let name=document.getElementById("custName").value.trim();
  let phone=document.getElementById("custPhone").value.trim();

  if(!name) return toast("Enter name");
  if(!phone) return toast("Enter phone");

  fetch(API_URL,{
    method:"POST",
    body: JSON.stringify({
      action: "add",
      name: name,
      phone: phone,
      items: cart.map(i => `${i.product} x${i.qty}`).join(", "),
      cart: cart
    })
  })
  .then(()=>{
    toast("Order saved");

    let msg = "NEW ORDER\n\n"+name+" | "+phone+"\n\n";
    cart.forEach(i=>{
      msg += `${i.product} x${i.qty}\n`;
    });

    window.open(`https://wa.me/916360397604?text=${encodeURIComponent(msg)}`);

    cart=[];
    updateCart();
    closeCart();
  })
  .catch(()=> toast("Error"));
}

function searchProduct(){
  let v=document.getElementById("search").value.toLowerCase();
  renderProducts(allProducts.filter(p=>p.product.toLowerCase().includes(v)));
}

function refreshData(){ loadData(); }

function toast(msg){
  let t=document.createElement("div");
  t.innerText=msg;
  t.style="position:fixed;bottom:20px;left:50%;transform:translateX(-50%);background:#000;color:#fff;padding:10px;border-radius:8px;";
  document.body.appendChild(t);
  setTimeout(()=>t.remove(),2000);
}

loadData();
</script>

</body>
</html>
